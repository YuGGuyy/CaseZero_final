# Server Port (Render sets this automatically; fallback for local dev)
PORT=5000

# MongoDB Connection URI
# Local: mongodb://127.0.0.1:27017/casezero
# Production Atlas: mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/casezero?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/casezero

# JWT Secret for signing auth tokens (Use a secure 64-char random string in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters

# Allowed Frontend Client Origin(s) for CORS & Socket.IO (comma-separated if multiple)
# Production example: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
